{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "码上解"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "decode-selection": {
      "description": "智能解码当前选中的内容",
      "suggested_key": {
        "default": "Alt+Shift+D"
      }
    },
    "encode-selection": {
      "description": "把当前选中的内容编码为 Base64",
      "suggested_key": {
        "default": "Alt+Shift+E"
      }
    }
  },
  "content_scripts": [
    {
      "js": [
        "codec.js",
        "store.js",
        "lib/qrcode.js",
        "lib/jsqr.js",
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "选中网页上的 Base64/Base32/Base58/Base122/Base32768/Hex/URL 编码/摩斯电码/JWT 等文本，右键一键智能解码，在原地弹出结果；也可编解码链、批量解码、二维码生成与识别、算哈希与 HMAC、AES/3DES/ChaCha20/SM4 加解密、RSA/ECDSA/SM2、JSON/URL/正则/Diff 开发工具。",
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "码上解",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "clipboardRead"
  ],
  "version": "4.0.0"
}