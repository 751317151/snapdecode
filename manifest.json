{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html",
    "default_title": "码上解"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "decode-selection": {
      "description": "智能解码当前选中的内容",
      "suggested_key": {
        "default": "Alt+Shift+D"
      }
    },
    "encode-selection": {
      "description": "把当前选中的内容编码为 Base64",
      "suggested_key": {
        "default": "Alt+Shift+E"
      }
    }
  },
  "content_scripts": [
    {
      "js": [
        "codec.js",
        "store.js",
        "content.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    }
  ],
  "description": "选中网页上的 Base64/Hex/URL 编码/JWT 等文本，右键一键智能解码，在原地弹出结果；也可编码、批量解码、算哈希、AES 加解密。",
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "码上解",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage"
  ],
  "version": "2.0.1"
}